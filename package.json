    "google-auth-library": "^9.11.0",
    "googleapis": "^140.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
